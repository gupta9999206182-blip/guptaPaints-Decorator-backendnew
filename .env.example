# Copy this file to .env and adjust values for your setup

PORT=5000

# MongoDB connection string
# Local MongoDB:
MONGO_URI=mongodb://127.0.0.1:27017/gupta_paints
# Or MongoDB Atlas (cloud, free tier):
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/gupta_paints

# Allow requests from your frontend's origin (Vite dev server default shown)
CLIENT_ORIGIN=http://localhost:5173
